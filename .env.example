# --- Database ---
# Local PostgreSQL defaults. Replace both values with the appropriate pooled and
# direct URLs when using a hosted PostgreSQL provider.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/abel_log?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/abel_log?schema=public"

# --- Auth.js ---
# Secret used to sign/encrypt the session cookie. Generate one with:
#   npx auth secret
# Never commit the real value.
AUTH_SECRET="replace-with-a-strong-random-string"

# --- Basecamp integration ---
# Public production origin used when writing sale links into Basecamp.
APP_BASE_URL="https://log.abeliquidators.com"

# Create the OAuth app at https://launchpad.37signals.com/integrations and use
# the exact callback URL below. BASECAMP_USER_AGENT must include contact info.
BASECAMP_CLIENT_ID=""
BASECAMP_CLIENT_SECRET=""
BASECAMP_OAUTH_REDIRECT_URI="https://log.abeliquidators.com/oauth/basecamp/callback"
BASECAMP_USER_AGENT="Abel Log Basecamp Integration (contact: operations@example.com)"

# An active MANAGEMENT user recorded as the creator of webhook-created sales.
BASECAMP_ACTOR_USER_ID=""

# Generate a long random value and include it in the registered webhook URL:
# https://log.abeliquidators.com/hooks/basecamp?token=<this value>
BASECAMP_WEBHOOK_TOKEN=""

# Shared only with the main website's server-side consultation endpoint. The
# website sends it as `Authorization: Bearer <token>` to POST /hooks/intake.
INTAKE_WEBHOOK_TOKEN=""

# --- Local demo seed ---
# The seed refuses to run unless this is explicitly enabled, and always refuses
# when NODE_ENV or VERCEL_ENV is production.
ENABLE_DEMO_SEED="false"

# Optional passwords used only when each demo account is first created. If a
# value is omitted, the seed generates and prints a random password once.
# SEED_PASSWORD_MANAGEMENT=""
# SEED_PASSWORD_TEAM_A=""
# SEED_PASSWORD_TEAM_B=""
# SEED_PASSWORD_TEAM_C=""
# SEED_PASSWORD_TEAM_D=""
# SEED_PASSWORD_TEAM_E=""
